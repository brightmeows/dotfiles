#!/usr/bin/env bash
# 仓库原生 git hook（core.hooksPath 指向本目录，安装命令见 AGENTS.md Git Workflow）
# 与旧 .pre-commit-config.yaml 等价：format-check/lint 全量，markdownlint 与中文引号检查仅暂存 md
# 只检查不写回；失败时本地修复（pnpm format / pnpm lint:fix）后重新 git add 提交

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# 合并/变基/还原进行中：跳过检查
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 ||
  git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1 ||
  git rev-parse -q --verify REVERT_HEAD >/dev/null 2>&1; then
  exit 0
fi

# 无暂存内容（--amend 等）：跳过
if git diff --cached --quiet; then
  exit 0
fi

echo "format-check: pnpm format:check"
pnpm format:check

echo "lint: pnpm lint"
pnpm lint

echo "check: Pi 运行时与 devDeps 版本"
pnpm check:pi

echo "check: 技能清单与本机安装"
node dot_agents_meow/scripts/check-skills.mjs --warn

# markdownlint：仅暂存且存在的 md 文件（--diff-filter=ACM 排除已删除的）
# core.quotepath=off：非 ASCII 文件名（如中文）原样输出，避免下游拿到带引号转义的假路径
mapfile -t md_files < <(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACM -- '*.md')
if ((${#md_files[@]} > 0)); then
  echo "markdownlint: ${md_files[*]}"
  markdownlint --config .markdownlint.toml "${md_files[@]}"

  # 中文引号：GB/T 15834-2011，弯引号规范（脚本有代码围栏豁免）
  # cn-quotes 仅适用于中文文档；.markdownlintignore 命中的 vendored 英文文档
  # （如 ext/ask-user-question/）不在中文引号规范适用范围内，同源过滤
  cq_files=()
  if [[ -f .markdownlintignore ]]; then
    mapfile -t cq_files < <(printf '%s\n' "${md_files[@]}" | grep -v -F -f .markdownlintignore)
  else
    cq_files=("${md_files[@]}")
  fi
  if ((${#cq_files[@]} > 0)); then
    echo "cn-quotes: ${cq_files[*]}"
    python3 dot_agents_meow/scripts/check-cn-quotes.py "${cq_files[@]}"
  fi
fi

# 模型域：models.toml、生成器或生成物被暂存时校验仓库产物一致性
if git -c core.quotepath=off diff --cached --name-only --diff-filter=ACM -- \
  dot_agents_meow/models/models.toml dot_agents_meow/models/gen-models.py \
  dot_pi/agent/models.json dot_pi/agent/models-dev.json | grep -q .; then
  echo "check: Pi 模型生成物与 models.toml 一致"
  python3 dot_agents_meow/models/gen-models.py --check
fi

# clash-meta 域：覆写壳模板、片段、地区数据、生成器或生成物被暂存时校验仓库产物一致性
if git -c core.quotepath=off diff --cached --name-only --diff-filter=ACM -- \
  dot_config/clash-meta/party-override.yaml.tmpl dot_config/clash-meta/gen-party-override.sh \
  dot_config/clash-meta/.fragments dot_config/clash-meta/party-override.yaml \
  .chezmoidata/clash-meta.yaml | grep -q .; then
  echo "check: clash-meta 覆写壳与模板/片段一致"
  bash dot_config/clash-meta/gen-party-override.sh --check
fi

# 单测：扩展与模型域代码、依赖变更时运行
if git -c core.quotepath=off diff --cached --name-only --diff-filter=ACM -- \
  dot_pi/agent/ext dot_agents_meow/models package.json pnpm-lock.yaml | grep -q .; then
  echo "test: 扩展与模型域单测"
  pnpm test
fi
