digraph STYLE_GUIDE {
    // 流程 DSL 风格指南，用 DSL 自身书写

    // 节点类型示例及对应形状
    subgraph cluster_node_types {
        label="节点类型与形状";

        // 问题是菱形
        "这是问题吗？" [shape=diamond];

        // 动作是方框（默认）
        "执行动作" [shape=box];

        // 命令为纯文本
        "git commit -m 'msg'" [shape=plaintext];

        // 状态为椭圆
        "当前状态" [shape=ellipse];

        // 警告为八角形
        "停止：严重警告" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        // 入口/出口为双圆
        "流程开始" [shape=doublecircle];
        "流程完成" [shape=doublecircle];

        // 各示例
        "测试通过了？" [shape=diamond];
        "先写测试" [shape=box];
        "npm test" [shape=plaintext];
        "卡住了" [shape=ellipse];
        "绝不使用 git add -A" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
    }

    // 边标记约定
    subgraph cluster_edge_types {
        label="边标记";

        "二选一？" [shape=diamond];
        "是路径" [shape=box];
        "否路径" [shape=box];

        "二选一？" -> "是路径" [label="是"];
        "二选一？" -> "否路径" [label="否"];

        "多选？" [shape=diamond];
        "选项 A" [shape=box];
        "选项 B" [shape=box];
        "选项 C" [shape=box];

        "多选？" -> "选项 A" [label="条件 A"];
        "多选？" -> "选项 B" [label="条件 B"];
        "多选？" -> "选项 C" [label="其他"];

        "进程 A 完成" [shape=doublecircle];
        "进程 B 开始" [shape=doublecircle];

        "进程 A 完成" -> "进程 B 开始" [label="触发", style=dotted];
    }

    // 命名模式
    subgraph cluster_naming_patterns {
        label="命名模式";

        // 问题以 ? 结尾
        "该做 X 吗？";
        "这可以是 Y 吗？";
        "Z 为真吗？";
        "已经做过 W 吗？";

        // 动作以动词开头
        "编写测试";
        "搜索模式";
        "提交变更";
        "寻求帮助";

        // 命令行直接书写
        "grep -r 'pattern' .";
        "git status";
        "npm run build";

        // 状态描述当前处境
        "测试失败中";
        "构建完成";
        "卡在错误上";
    }

    // 流程结构模板
    subgraph cluster_structure {
        label="流程结构模板";

        "触发：某事发生" [shape=ellipse];
        "初步检查？" [shape=diamond];
        "主动作" [shape=box];
        "git status" [shape=plaintext];
        "另一检查？" [shape=diamond];
        "替代动作" [shape=box];
        "停止：不要这样做" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "流程完成" [shape=doublecircle];

        "触发：某事发生" -> "初步检查？";
        "初步检查？" -> "主动作" [label="是"];
        "初步检查？" -> "替代动作" [label="否"];
        "主动作" -> "git status";
        "git status" -> "另一检查？";
        "另一检查？" -> "流程完成" [label="正常"];
        "另一检查？" -> "停止：不要这样做" [label="有问题"];
        "替代动作" -> "流程完成";
    }

    // 何时使用哪种形状
    subgraph cluster_shape_rules {
        label="何时使用各形状";

        "选择形状" [shape=ellipse];

        "是决策吗？" [shape=diamond];
        "用菱形" [shape=diamond, style=filled, fillcolor=lightblue];

        "是命令吗？" [shape=diamond];
        "用纯文本" [shape=plaintext, style=filled, fillcolor=lightgray];

        "是警告吗？" [shape=diamond];
        "用八角形" [shape=octagon, style=filled, fillcolor=pink];

        "是入口/出口吗？" [shape=diamond];
        "用双圆" [shape=doublecircle, style=filled, fillcolor=lightgreen];

        "是状态吗？" [shape=diamond];
        "用椭圆" [shape=ellipse, style=filled, fillcolor=lightyellow];

        "默认用方框" [shape=box, style=filled, fillcolor=lightcyan];

        "选择形状" -> "是决策吗？";
        "是决策吗？" -> "用菱形" [label="是"];
        "是决策吗？" -> "是命令吗？" [label="否"];
        "是命令吗？" -> "用纯文本" [label="是"];
        "是命令吗？" -> "是警告吗？" [label="否"];
        "是警告吗？" -> "用八角形" [label="是"];
        "是警告吗？" -> "是入口/出口吗？" [label="否"];
        "是入口/出口吗？" -> "用双圆" [label="是"];
        "是入口/出口吗？" -> "是状态吗？" [label="否"];
        "是状态吗？" -> "用椭圆" [label="是"];
        "是状态吗？" -> "默认用方框" [label="否"];
    }

    // 好例子 vs 坏例子
    subgraph cluster_examples {
        label="好 vs 坏示例";

        // 好：具体且形状正确
        "测试失败" [shape=ellipse];
        "读取错误信息" [shape=box];
        "能复现吗？" [shape=diamond];
        "git diff HEAD~1" [shape=plaintext];
        "绝不忽略错误" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        "测试失败" -> "读取错误信息";
        "读取错误信息" -> "能复现吗？";
        "能复现吗？" -> "git diff HEAD~1" [label="是"];

        // 坏：模糊且形状错误
        bad_1 [label="出了点问题", shape=box];  // 应为椭圆（状态）
        bad_2 [label="修一下", shape=box];  // 过于模糊
        bad_3 [label="检查", shape=box];  // 应为菱形
        bad_4 [label="运行命令", shape=box];  // 应为纯文本+实际命令

        bad_1 -> bad_2;
        bad_2 -> bad_3;
        bad_3 -> bad_4;
    }
}