# 复制模式（默认）：目标文件是源文件的副本，需要 chezmoi apply 同步。
# 不用 symlink 模式：fcitx5 等运行时会回写自身配置文件，symlink 会让回写穿透到仓库源文件。
mode = "file"

{{ if and (eq .chezmoi.os "windows") (lookPath "bash") -}}
[interpreters]
sh = { command = {{ lookPath "bash" | toJson }} }
{{- end }}

# run_after_ 脚本每次 apply 都在“待执行”集合里，diff/status 默认把它们渲染成 new file 噪声
# （机制备案见 docs/dev/chezmoi-sync-scripts.md）；脚本执行过程用 chezmoi apply --verbose 查看。
[diff]
exclude = ["scripts"]

[status]
exclude = ["scripts"]
