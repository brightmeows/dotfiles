# 本文件由 chezmoi 模板生成：上游 Omarchy tmux.conf 原文 + 字母系追加段。
# 上游源：/usr/share/omarchy/config/tmux/tmux.conf（omarchy-refresh-tmux 覆盖本文件后，
# 跑 `chezmoi apply` 恢复；模板每次 apply 实时拉取最新上游，不产生漂移）。
# 设计与覆盖恢复记录见 docs/omarchy-tmux-chezmoi拼接与refresh覆盖恢复.md。
{{ output "cat" "/usr/share/omarchy/config/tmux/tmux.conf" }}
# ===== 字母系追加段（zellij 手感对齐；与上游方向键系并存，物理正交零冲突）=====

# prefix：Alt+i（对齐 zellij 模式入口；Ctrl+Space 让给 fcitx5 中英文切换，
# fcitx5 在输入法层拦截该键，TUI 收不到，留着是死键）。
# 上游 prefix2 C-b 自动降级为备用 prefix，保留。
set -g prefix M-i
unbind C-Space
bind M-i send-prefix

# 焦点：Alt+hjkl（对齐 zellij MoveFocus）
bind -n M-h select-pane -L
bind -n M-j select-pane -D
bind -n M-k select-pane -U
bind -n M-l select-pane -R

# 移动窗格：Alt+Shift+hjkl（对齐 zellij MovePane；tmux 用 {left-of} 等标记与邻格交换）
bind -n M-H swap-pane -s '{left-of}'
bind -n M-J swap-pane -s '{down-of}'
bind -n M-K swap-pane -s '{up-of}'
bind -n M-L swap-pane -s '{right-of}'

# 切标签：Alt+u/o（对齐 zellij GoToPreviousTab/GoToNextTab）
bind -n M-u previous-window
bind -n M-o next-window

# 移动标签：Alt+Shift+u/o（对齐 zellij MoveTab，焦点跟切，与上游 M-S-Left/Right 同语义）
bind -n M-U swap-window -t -1 \; select-window -t -1
bind -n M-O swap-window -t +1 \; select-window -t +1

# 清理 prefix 冗余切换路径：切换统一走直接键（标签 Alt+u/o，session Alt+Up/Down）。
# p/n 是 tmux 出厂默认残留（上游未清），P/N 是上游所设的 session 切换。
unbind p
unbind n
unbind P
unbind N

# ===== 标签细节补齐（对齐 zellij 的 t 模式内操作；herdr 缺对应键位动作，已向上游提需求）=====

# 最近标签：prefix+Tab（对齐 zellij tab 键语义）。覆盖 tmux 3.4+ 默认的 popup Tab；
# tmux 默认残留 prefix+l 也是 last-window，留作双路径。
bind Tab last-window

# 拆窗格到标签：prefix+b 拆到新标签（zellij b）；prefix+j / J 拆到前/后相邻标签
# （zellij [ / ] 的语义错，[ 在 tmux 是 copy-mode 入口让位，j 助记 join；
# join-pane 默认焦点跟随到新位置）。
bind b break-pane
bind j join-pane -t -1
bind J join-pane -t +1

# 同步输入：prefix+s 开关 synchronize-panes（setw 对 flag 选项省略值 = toggle，已实测）。
# 覆盖 tmux 默认的 choose-tree session 树；session 切换已有 Alt+Up/Down 直接键。
bind s setw synchronize-panes
