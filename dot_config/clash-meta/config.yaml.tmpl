# 分流规则
rules:
  # 订阅源直连（打破下载死锁：respect-rules 下 DIRECT 域名用 nameserver 解析 + 直连，不依赖节点）
  # 同域名多订阅去重（与 nameserver-policy 一致），避免生成冗余规则
{{- $seen := dict }}
{{- range $sub := $subs }}
{{- $kv := splitList "=" $sub }}
{{- if ge (len $kv) 2 }}
{{- $url := join "=" (rest $kv) }}
{{- if and (ne (trim $url) "") (or (hasPrefix "http://" $url) (hasPrefix "https://" $url)) }}
{{- $u := urlParse $url }}
{{- if and $u.host (not (hasKey $seen $u.host)) }}
{{- $_ := set $seen $u.host true }}
  - DOMAIN,{{ $u.host }},DIRECT
{{- end }}
{{- end }}
{{- end }}
{{- end }}
  # SSH 直连：机场普遍封出站 22 端口（防 SSH 跳板），SSH 走代理必然超时
  # 一条端口规则覆盖所有 SSH 目标，无需逐域名添加
  - DST-PORT,22,DIRECT

  ### 非 IP 类规则
  - RULE-SET,reject_non_ip,REJECT
  - RULE-SET,reject_domainset,REJECT
