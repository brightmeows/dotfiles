# 分流规则
rules:
  # 订阅源直连（打破下载死锁：respect-rules 下 DIRECT 域名用 nameserver 解析 + 直连，不依赖节点）
{{- range $sub := $subs }}
{{- $kv := splitList "=" $sub }}
{{- if ge (len $kv) 2 }}
{{- $url := join "=" (rest $kv) }}
{{- if and (ne (trim $url) "") (or (hasPrefix "http://" $url) (hasPrefix "https://" $url)) }}
{{- $u := urlParse $url }}
{{- if $u.host }}
  - DOMAIN,{{ $u.host }},DIRECT
{{- end }}
{{- end }}
{{- end }}
{{- end }}
  # GitHub SSH直连规则
  # 精确匹配GitHub SSH连接（支持AND操作符的内核）
  # 1. HTTPS隧道SSH：ssh.github.com:443
  - DOMAIN,ssh.github.com,DIRECT
  # 2. 传统SSH：github.com:22（使用AND操作符组合域名和端口）
  - AND,(DOMAIN,github.com),(DST-PORT,22),DIRECT

  ### 非 IP 类规则
  - RULE-SET,reject_non_ip,REJECT
  - RULE-SET,reject_domainset,REJECT
  - RULE-SET,reject_non_ip_drop,REJECT-DROP
  - RULE-SET,reject_non_ip_no_drop,REJECT
  - RULE-SET,cdn_domainset,节点选择
  - RULE-SET,cdn_non_ip,节点选择
  - RULE-SET,stream_non_ip,节点选择
  - RULE-SET,telegram_non_ip,节点选择
  - RULE-SET,apple_cdn,DIRECT
  - RULE-SET,download_domainset,节点选择
  - RULE-SET,download_non_ip,节点选择
  - RULE-SET,microsoft_cdn_non_ip,DIRECT
  - RULE-SET,apple_cn_non_ip,DIRECT
  - RULE-SET,apple_services,节点选择
  - RULE-SET,microsoft_non_ip,节点选择
  - RULE-SET,ai_non_ip,节点选择
  - RULE-SET,global_non_ip,节点选择
  - RULE-SET,domestic_non_ip,DIRECT
  - RULE-SET,direct_non_ip,DIRECT
  - RULE-SET,lan_non_ip,DIRECT

  ### IP 类规则
  - RULE-SET,reject_ip,REJECT
  - RULE-SET,telegram_ip,节点选择
  - RULE-SET,stream_ip,节点选择
  - RULE-SET,lan_ip,DIRECT
  - RULE-SET,domestic_ip,DIRECT
  - RULE-SET,china_ip,DIRECT

  - MATCH,节点选择
