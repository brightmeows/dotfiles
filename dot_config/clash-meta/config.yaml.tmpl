  - { name: 🇸🇬 - 手动选择, <<: *Select, filter: *FilterSG }
  - { name: 🇺🇸 - 手动选择, <<: *Select, filter: *FilterUS }
  - { name: 🇬🇧 - 手动选择, <<: *Select, filter: *FilterUK }
  - { name: 🇫🇷 - 手动选择, <<: *Select, filter: *FilterFR }
  - { name: 🇩🇪 - 手动选择, <<: *Select, filter: *FilterDE }
  - { name: 🇹🇼 - 手动选择, <<: *Select, filter: *FilterTW }
  - { name: Others - 手动选择, <<: *Select, filter: *FilterOthers }

### 规则配置
RuleSet_classical:
  &RuleSet_classical {
    type: http,
    behavior: classical,
    interval: 43200,
    format: text,
    proxy: 🎯 节点选择,
  }
RuleSet_domain:
  &RuleSet_domain {
    type: http,
    behavior: domain,
    interval: 43200,
    format: text,
    proxy: 🎯 节点选择,
  }
RuleSet_ipcidr:
  &RuleSet_ipcidr {
    type: http,
    behavior: ipcidr,
    interval: 43200,
    format: text,
    proxy: 🎯 节点选择,
  }

# 订阅规则
rule-providers:
  reject_non_ip_no_drop:
    <<: *RuleSet_classical
    url: "https://ruleset.skk.moe/Clash/non_ip/reject-no-drop.txt"
