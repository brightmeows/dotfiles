# Ctrl+Space stays with fcitx5; tmux and herdr use Alt+i as their prefix.
# Omarchy's input-method migration can remove Control+space; the post-update
# hook restores this file. If you run `omarchy input method configure
# --defaults` manually, run `chezmoi apply` afterwards.
[Hotkey/TriggerKeys]
0=Control+space
1=Zenkaku_Hankaku
2=Hangul

# A lone Shift used to be disabled for this setup; Ctrl+Space is the only
# Chinese/English toggle.
[Hotkey/AltTriggerKeys]
0=

[Behavior]
ActiveByDefault=False
