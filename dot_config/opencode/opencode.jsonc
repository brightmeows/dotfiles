{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": false,
  "formatter": false,
  "plugin": [],
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
  },
  "permission": {
    "skill": {
      "using-superpowers": "deny",
      "caveman": "deny",
    },
    "read": {
      "/tmp/*": "allow",
      ".agents_tmp/*": "allow",
      "/nix/store/*": "allow",
    },
    "edit": {
      "/tmp/*": "allow",
      ".agents_tmp/*": "allow",
    },
  },
}
