{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": false,
  "formatter": false,
  "plugin": [],
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
    },
    "paper-search-mcp": {
      "type": "local",
      "command": ["uvx", "paper-search-mcp"],
      "enabled": false,
    },
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
  },
  "permission": {
    "skill": {
      "using-superpowers": "deny",
      "caveman": "deny",
    },
    "read": {
      "/tmp/*": "allow",
      ".agents_tmp/*": "allow",
      "/nix/store/*": "allow",
      "~/.local/share/rtk/tee/*": "allow",
    },
    "edit": {
      "/tmp/*": "allow",
      ".agents_tmp/*": "allow",
    },
  },
}
