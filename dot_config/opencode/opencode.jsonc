{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": false,
  "mcp": {
    "pdf-reader": {
      "enabled": false,
      "type": "local",
      "command": [
        "pnpx",
        "@sylphx/pdf-reader-mcp",
      ],
    },
  },
  "permission": {
    "read": {
      "~/tmp": "allow",
      "/tmp": "allow",
    },
    "write": {
      "~/tmp": "allow",
      "/tmp": "allow",
    },
    "edit": {
      "~/tmp": "allow",
      "/tmp": "allow",
    }
  }
}