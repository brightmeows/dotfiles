{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": false,
  "formatter": false,
  "agent": {
    "explore": {
      "disable": true,
    },
  },
  "permission": {
    "read": {
      "/tmp/**": "allow",
      ".agents_tmp/**": "allow",
    },
    "edit": {
      "/tmp/**": "allow",
      ".agents_tmp/**": "allow",
    },
  },
}