{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": false,
  "formatter": false,
  "plugin": [
    "superpowers-zh@git+https://github.com/jnMetaCode/superpowers-zh.git",
  ],
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
  },
  "permission": {
    "read": {
      "/tmp/*": "allow",
      "/tmp/**": "allow",
      ".agents_tmp/*": "allow",
      ".agents_tmp/**": "allow",
      "/nix/store/*": "allow",
      "/nix/store/**": "allow",
    },
    "edit": {
      "/tmp/*": "allow",
      "/tmp/**": "allow",
      ".agents_tmp/*": "allow",
      ".agents_tmp/**": "allow",
    },
  },
}