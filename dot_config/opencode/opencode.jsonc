{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [],
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
    },
    "anysearch": {
      "type": "remote",
      "url": "https://api.anysearch.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:ANYSEARCH_API_KEY}",
      },
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "cratesio-mcp": {
      "type": "local",
      "command": ["cratesio-mcp"],
      "enabled": true,
    },
    "paper-search-mcp": {
      "type": "local",
      "command": ["uvx", "git+https://github.com/openags/paper-search-mcp.git"],
      "enabled": false,
    },
    "docs-rs-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@nuskey8/docs-rs-mcp@latest"],
      "enabled": false,
    },
    "cnki-mcp": {
      "type": "local",
      "command": ["uvx", "git+https://github.com/h-lu/cnki-mcp.git"],
      "enabled": false,
    },
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/.agents_tmp/**": "allow",
      "/nix/store/**": "allow",
      "~/.local/share/rtk/tee/**": "allow",
      "~/.cargo/registry/**": "allow",
    },
    "read": {
      "/tmp/**": "allow",
      "~/.agents_tmp/**": "allow",
      "/nix/store/**": "allow",
      "~/.local/share/rtk/tee/**": "allow",
      "~/.cargo/registry/**": "allow",
    },
    "edit": {
      "/tmp/**": "allow",
      "~/.agents_tmp/**": "allow",
    },
    "skill": {},
  },
}
