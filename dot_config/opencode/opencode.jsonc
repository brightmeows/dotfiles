{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [],
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
    },
    "paper-search-mcp": {
      "type": "local",
      "command": ["uvx", "git+https://github.com/openags/paper-search-mcp.git"],
      "enabled": false,
    },
    "cnki-mcp": {
      "type": "local",
      "command": ["uvx", "git+https://github.com/h-lu/cnki-mcp.git"],
      "enabled": false,
    },
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
  },
  "permission": {
    "read": {
      "/tmp/*": "allow",
      ".agents_tmp/*": "allow",
      "/nix/store/*": "allow",
      "~/.local/share/rtk/tee/*": "allow",
      "~/.cargo/registry/*": "allow",
    },
    "edit": {
      "/tmp/*": "allow",
      ".agents_tmp/*": "allow",
    },
  },
}
