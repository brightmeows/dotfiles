{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": false,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
  ],
  "mcp": {
    "pdf-reader": {
      "enabled": false,
      "type": "local",
      "command": [
        "pnpx",
        "@sylphx/pdf-reader-mcp",
      ],
    },
  },
  "agent": {
    "explore": {
      "disable": true,
    },
  },
}