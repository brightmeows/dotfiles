{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": false,
  "formatter": false,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
  ],
  "mcp": {
    "pdf-reader": {
      "enabled": false,
      "type": "local",
      "command": [
        "pnpx",
        "@sylphx/pdf-reader-mcp",
      ],
    },
  },
  "agent": {
    "explore": {
      "disable": true,
    },
  },
  "permission": {
    "read": {
      "/tmp/**": "allow",
      ".agents_tmp/**": "allow",
    },
    "write": {
      "/tmp/**": "allow",
      ".agents_tmp/**": "allow",
    },
    "edit": {
      "/tmp/**": "allow",
      ".agents_tmp/**": "allow",
    },
  },
}