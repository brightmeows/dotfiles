{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "anysearch": {
      "type": "remote",
      "url": "https://api.anysearch.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:ANYSEARCH_API_KEY}",
      },
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "cratesio-mcp": {
      "type": "local",
      "command": ["cratesio-mcp"],
      "enabled": true,
    },
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/.agents_tmp/**": "allow",
      "~/.cargo/registry/**": "allow",
    },
    "read": {
      "/tmp/**": "allow",
      "~/.agents_tmp/**": "allow",
      "~/.cargo/registry/**": "allow",
    },
    "edit": {
      "/tmp/**": "allow",
      "~/.agents_tmp/**": "allow",
    },
    "skill": {},
  },
}
