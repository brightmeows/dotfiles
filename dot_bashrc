# Load env file with += (append) and <= (prepend) support
# Format: KEY=VALUE | KEY+=value (append with :) | KEY<=value (prepend with :)
_load_env_file() {
    local file="$1"
    [ -f "$file" ] || return 0
    local key value current
    while IFS='=' read -r key value; do
        [[ "$key" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${key// }" ]] && continue
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        local op="="
        if [[ "$key" == *+ ]]; then op="+="; key="${key%+}"
        elif [[ "$key" == *\< ]]; then op="<="; key="${key%\<}"; fi
        value="${value/#\~/$HOME}"
        case "$op" in
            =)  export "$key=$value" ;;
            "+=") current="${!key}"; export "$key=${current:+$current:}$value" ;;
            "<=") current="${!key}"; export "$key=$value${current:+:$current}" ;;
        esac
    done < "$file"
}

_load_env_file "$HOME/.env_common"
_load_env_file "$HOME/.env_self"

