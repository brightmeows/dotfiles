export PATH="$PATH"
export PATH="$PATH:$HOME/bin"
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/go/bin"
export PATH="$PATH:$HOME/.cargo/bin"
export PATH="$PATH:$HOME/.opencode/bin"
export PATH="$PATH:$HOME/.bun/bin"
# AppImages (建议使用 Gear Lever 管理 AppImages)
# flatpak install flathub it.mijorus.gearlever
export PATH="$PATH:$HOME/AppImages"

# Load custom environment variables
if [ -f "$HOME/.env_self" ]; then
    set -a
    source "$HOME/.env_self"
    set +a
fi

alias k="kubectl"
alias ze="zellij"
alias oc="opencode"
alias nv="nvim"
alias lg="lazygit"
alias urldecode="python3 -c 'import sys, urllib.parse as ul; print(ul.unquote_plus(sys.stdin.read()))'"
alias urlencode="python3 -c 'import sys, urllib.parse as ul; print(ul.quote_plus(sys.stdin.read()))'"

if command -v nixvim &> /dev/null; then
    export EDITOR=nixvim
fi

# GitHub CLI token
if command -v gh &> /dev/null; then
    GH_TOKEN=$(gh auth token 2>/dev/null)
    if [ -n "$GH_TOKEN" ]; then
        export GITHUB_TOKEN="$GH_TOKEN"
    fi
fi

export NIXPKGS_ALLOW_UNFREE=1
