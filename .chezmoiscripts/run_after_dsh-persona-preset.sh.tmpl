#!/bin/bash
# 生成 dsh“白小喵モード”预设：人设走 persona 平面（系统提示词最前的 DEPLOYMENT_PERSONA_PREFIX），
# 源是 dot_agents_meow/SOUL.md。
# 为什么用 run_after_ 而不是 onchange：dsh 升级会换掉自带的 standard 预设，脚本自身 hash
# 不变时 onchange 不重跑，预设就会停在旧组合上；脚本本身幂等，内容无变化时不写盘。
set -euo pipefail

if ! command -v python3 >/dev/null 2>&1; then
  echo "Warning: python3 缺失，跳过 dsh 人设预设生成" >&2
  exit 0
fi

python3 "{{ .chezmoi.sourceDir }}/dot_agents_meow/scripts/gen-dsh-preset.py"
