#!/bin/bash
# Merge managed Pi settings (from settings.meow.json) into settings.json
# Pi-managed keys (provider, model, lastChangelogVersion) are preserved.
# Trigger: reruns when settings.meow.json content changes
# settings.meow.json hash: {{ include "dot_pi/agent/settings.meow.json" | sha256sum }}
set -euo pipefail

SETTINGS="${HOME}/.pi/agent/settings.json"
MEOW="${HOME}/.pi/agent/settings.meow.json"

if [ ! -f "$MEOW" ]; then
  echo "Warning: $MEOW not found, skipping merge" >&2
  exit 0
fi

mkdir -p "$(dirname "$SETTINGS")"

# If it's a symlink (from previous chezmoi management), remove it first
# to avoid writing into the dotfiles repo by accident.
if [ -L "$SETTINGS" ]; then
  rm "$SETTINGS"
fi

MANAGED=$(cat "$MEOW")

if [ ! -f "$SETTINGS" ]; then
  echo "$MANAGED" > "$SETTINGS"
else
  # Merge: managed keys overwrite settings.json values.
  # 'packages' keeps pi-install additions but lets the managed list retract by
  # package identity: a live spec whose base name (npm: scope/name, or path)
  # matches a managed package is dropped even when the version differs.
  # Union alone is not enough — removing a pin from the managed list would
  # otherwise leave the old spec in place forever.
  jq -s '
    (.[0].packages // []) as $mp |
    (.[1].packages // []) as $sp |
    def base:
      if startswith("npm:") then
        (.[4:] | if startswith("@") then (split("@") | .[0:2] | join("@")) else (split("@") | .[0]) end)
      else . end;
    (.[1] * .[0]) |
    .packages = (($mp | map(base)) as $mb
      | ($mp + ($sp | map(select(. as $p | ($mb | index($p | base)) | not))))
      | unique)
  ' "$MEOW" "$SETTINGS" > "${SETTINGS}.tmp" \
    && mv "${SETTINGS}.tmp" "$SETTINGS"
fi
