#!/bin/bash
# Merge managed Pi settings (from settings.meow.json) into settings.json
# Pi-managed keys (provider, model, lastChangelogVersion) are preserved.
# packages: managed list wins on package identity (base name); entries
# recorded in the snapshot but absent from the managed list are retracted
# (managed deletion propagates); everything else is Pi-added and kept.
# Trigger: reruns when settings.meow.json content changes
# settings.meow.json hash: {{ include "dot_pi/agent/settings.meow.json" | sha256sum }}
set -euo pipefail

SETTINGS="${HOME}/.pi/agent/settings.json"
MEOW="${HOME}/.pi/agent/settings.meow.json"
SNAP="${HOME}/.pi/agent/.meow-settings-snapshot.json"

if [ ! -f "$MEOW" ]; then
  echo "Warning: $MEOW not found, skipping merge" >&2
  exit 0
fi

mkdir -p "$(dirname "$SETTINGS")"

# If it's a symlink (from previous chezmoi management), remove it first
# to avoid writing into the dotfiles repo by accident.
if [ -L "$SETTINGS" ]; then
  rm "$SETTINGS"
fi

MANAGED=$(cat "$MEOW")

if [ ! -f "$SETTINGS" ]; then
  echo "$MANAGED" > "$SETTINGS"
else
  # First run has no snapshot: everything already in settings.json counts
  # as Pi-added, so the union semantics carry over unchanged.
  [ -f "$SNAP" ] || echo '{"packages": []}' > "$SNAP"

  jq -s --slurpfile snap "$SNAP" '
    def base:
      if startswith("npm:") then
        (.[4:] | if startswith("@") then (split("@") | .[0:2] | join("@")) else (split("@") | .[0]) end)
      else . end;
    (.[0].packages // []) as $mp |
    (.[1].packages // []) as $sp |
    (($snap[0].packages // []) | map(base)) as $sb |
    ([$mp[] | base]) as $mb |
    (.[1] * .[0]) |
    .packages = ($mp
      + ($sp | map(select(
          (. as $p
            | (($sb | index($p | base)) | not)
            and (($mb | index($p | base)) | not))
        )))
      | unique)
  ' "$MEOW" "$SETTINGS" > "${SETTINGS}.tmp" \
    && mv "${SETTINGS}.tmp" "$SETTINGS"
fi

# Record the managed set as the snapshot only after a successful merge.
echo "$MANAGED" | jq '{packages: (.packages // [])}' > "$SNAP"
