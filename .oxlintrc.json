{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "deny",
    "suspicious": "deny",
    "perf": "deny",
    "style": "deny",
    "pedantic": "off"
  },
  "plugins": ["typescript", "oxc", "unicorn"],
  "rules": {
    "no-console": "off",
    "no-magic-numbers": "off",
    "func-style": "off",
    "id-length": "off",
    "unicorn/no-null": "off",
    "no-continue": "off",
    "no-ternary": "off",
    "max-statements": "off",
    "unicorn/consistent-function-scoping": "off",
    "sort-keys": "off",
    "init-declarations": "off",
    "prefer-named-capture-group": "off",
    "func-names": "off",
    "sort-imports": "off",
    "new-cap": [
      "deny",
      {
        "properties": false
      }
    ]
  },
  "ignorePatterns": ["node_modules"]
}
