{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "lifecycle": "keep-alive",
      "directTools": true
    },
    "anysearch": {
      "url": "https://api.anysearch.com/mcp",
      "lifecycle": "keep-alive",
      "directTools": true
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "lifecycle": "keep-alive",
      "directTools": true
    },
    "cratesio-mcp": {
      "command": "cratesio-mcp",
      "lifecycle": "keep-alive",
      "directTools": true
    },
    "paper-search-mcp": {
      "command": "uvx",
      "args": [
        "git+https://github.com/openags/paper-search-mcp.git"
      ]
    },
    "cnki-mcp": {
      "command": "uvx",
      "args": [
        "git+https://github.com/h-lu/cnki-mcp.git"
      ]
    },
    "docs-rs-mcp": {
      "command": "pnpx",
      "args": [
        "@nuskey8/docs-rs-mcp@latest"
      ]
    }
  }
}
