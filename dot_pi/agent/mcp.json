{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "enabled": false,
      "exposure": "codemode"
    },
    "anysearch": {
      "url": "https://api.anysearch.com/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer ${ANYSEARCH_API_KEY}"
      },
      "exposure": "codemode"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "exposure": "codemode"
    },
    "cratesio-mcp": {
      "command": "cratesio-mcp",
      "exposure": "codemode"
    },
    "paper-search-mcp": {
      "command": "uvx",
      "args": ["git+https://github.com/openags/paper-search-mcp.git"],
      "exposure": "codemode"
    }
  }
}
