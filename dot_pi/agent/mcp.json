{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "exposure": "codemode"
    },
    "anysearch": {
      "url": "https://api.anysearch.com/mcp",
      "headers": {
        "Authorization": "Bearer ${ANYSEARCH_API_KEY}"
      },
      "exposure": "codemode"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "exposure": "codemode"
    },
    "cratesio-mcp": {
      "command": "cratesio-mcp",
      "exposure": "codemode"
    },
    "paper-search-mcp": {
      "command": "uvx",
      "args": ["git+https://github.com/openags/paper-search-mcp.git"],
      "exposure": "codemode"
    },
    "docs-rs-mcp": {
      "command": "npx",
      "args": ["-y", "@nuskey8/docs-rs-mcp@latest"],
      "exposure": "codemode"
    },
    "zai-mcp-server": {
      "command": "npx",
      "args": ["-y", "@z_ai/mcp-server@latest"],
      "env": {
        "Z_AI_API_KEY": "${ZHIPU_API_KEY}",
        "Z_AI_MODE": "ZHIPU"
      },
      "enabled": false
    }
  }
}
