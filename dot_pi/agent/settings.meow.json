{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "catppuccin-mocha",
  "quietStartup": "header",
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "enableSkillCommands": true,
  "codemode": {
    "mode": "on",
    "inlineBudget": 65536
  },
  "applyPatch": {
    "contextLines": 1,
    "maxChangedLines": 10
  },
  "defaultTools": ["-edit", "-write"],
  "packages": [
    "npm:@brightmeows/pi-aliases",
    "npm:@brightmeows/pi-ask-user-question",
    "npm:@brightmeows/pi-git-attribution",
    "npm:@brightmeows/pi-git-hooks",
    "npm:@brightmeows/pi-herdr-blocked",
    "npm:@brightmeows/pi-inline-context",
    "npm:@brightmeows/pi-models-dev",
    "npm:@brightmeows/pi-skill-reminders",
    "npm:@brightmeows/pi-subdir-agents-md",
    "npm:@brightmeows/pi-tui-editor-input-tweaks",
    "npm:@brightmeows/pi-tui-esc-hold",
    "npm:@brightmeows/pi-tui-statusline",
    "npm:@brightmeows/pi-tui-thinking-flow",
    "npm:@brightmeows/pi-tui-working-status",
    "npm:@d3ara1n/pi-apply-patch",
    "npm:@sidshaytay/pi-secret-safe",
    "npm:pi-goal-moonland",
    "npm:pi-web-access"
  ]
}
