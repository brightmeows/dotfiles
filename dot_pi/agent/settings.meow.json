{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "catppuccin-mocha",
  "quietStartup": "header",
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "enableSkillCommands": true,
  "codemode": {
    "mode": "on",
    "inlineBudget": 65536
  },
  "applyPatch": {
    "contextLines": 1,
    "maxChangedLines": 10
  },
  "defaultTools": ["-edit", "-write"],
  "packages": [
    "npm:@d3ara1n/pi-apply-patch",
    "npm:pi-lsp-extension",
    "npm:pi-web-access",
    "./ext/aliases",
    "./ext/apply-patch-tweaks",
    "./ext/ask-user-question",
    "./ext/editor-input-tweaks",
    "./ext/esc-hold",
    "./ext/git-hooks",
    "./ext/herdr-blocked",
    "./ext/inline-context",
    "./ext/models-dev",
    "./ext/skill-reminders",
    "./ext/statusline",
    "./ext/subdir-agents-md",
    "./ext/thinking-flow",
    "./ext/working-status"
  ]
}
