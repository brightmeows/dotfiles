# DeepSeek Harness home 级 patch（部署为 $DSH_HOME/cordis.patch.yml），对全部 profile 生效。
# 源文件：dot_dsh/cordis.patch.yml.tmpl。
# 模型配置不在此层：models-dev 插件在运行时抓取外部目录、叠加
# ~/.agents_meow/models/models.toml 的用户配置，写入各 profile 的 cordis.patch.yml 生成块。
# 凭据来自启动环境（如从终端启动，~/.env_self 已加载）。

- insert:
    - id: mcp-exa
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: exa
        transport: streamable-http
        url: https://mcp.exa.ai/mcp

    - id: mcp-anysearch
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: anysearch
        transport: streamable-http
        url: https://api.anysearch.com/mcp
        headers:
          Authorization: !!js "`Bearer ${process.env.ANYSEARCH_API_KEY}`"

    - id: mcp-context7
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: context7
        transport: streamable-http
        url: https://mcp.context7.com/mcp

    - id: mcp-cratesio
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: cratesio-mcp
        transport: stdio
        command: cratesio-mcp

    - id: mcp-zai
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: zai-mcp-server
        transport: stdio
        command: npx
        args: ['-y', '@z_ai/mcp-server@latest']
        env:
          Z_AI_API_KEY: !!js process.env.ZHIPU_API_KEY
          Z_AI_MODE: ZHIPU

    - id: models-dev
      name: '{{ .chezmoi.homeDir }}/.agents_meow/models/plugin.mts'
      config:
        resolvedPath: '{{ .chezmoi.homeDir }}/.agents_meow/models/resolved.json'
        cachePath: '{{ .chezmoi.homeDir }}/.dsh/cache/models-dev.json'

# 人设平面：dsh 的 preset 会遮蔽部署级 persona，而人设必须挂在 persona 平面（提示词最前）
# 才稳，所以默认预设换成派生的“白小喵モード”；本行替换 web-app bundle 的整份 config
# （patch 语义：按 id 命中、整份 config 覆盖）。预设本体由
# .chezmoiscripts/run_after_dsh-persona-preset.sh.tmpl 从自带 standard 预设生成。
- id: agent-presets
  name: '@deepseek-ai/dsh-agent-presets'
  config:
    default: bai-xiaomiao
